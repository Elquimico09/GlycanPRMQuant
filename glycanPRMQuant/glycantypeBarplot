import pandas as pd
import matplotlib.pyplot as plt
import scienceplots

from glycanPRMQuant.glycanClassification import classifyGlycan 

def plot_barplot(consolidated_csv: str,
                                 save_path: str = None) -> pd.Series:
    """
    Given a consolidated AUC CSV, classify each glycan, compute per-sample
    relative abundances, then average those relative abundances by glycan class
    and plot a colored bar chart.

    Returns
    -------
    pd.Series
        The mean relative abundance for each glycan class (indexed by class name).
    """
    # set plotting style
    plt.style.use(['science', 'no-latex'])
    plt.rcParams['font.family'] = 'Arial'

    # 1) classify
    df = classifyGlycan(consolidated_csv)

    # 2) identify sample columns (everything except Glycan, pos1–pos5, Class)
    meta = {'Glycan', 'pos1', 'pos2', 'pos3', 'pos4', 'pos5', 'Class'}
    sample_cols = [c for c in df.columns if c not in meta]

    # 3) compute relative abundance per sample
    rel = df.copy()
    rel[sample_cols] = rel[sample_cols].div(rel[sample_cols].sum(axis=0), axis=1)

    # 4) sum relative abundances by class, then average across samples
    summed = rel.groupby('Class')[sample_cols].sum()
    means  = summed.mean(axis=1)

    # 5) keep only the four target classes, in desired order
    class_order = ['high mannose', 'sialofucosylated', 'sialylated', 'fucosylated']
    means = means.reindex(class_order).fillna(0)

    # 6) bar‐plot with specified colors
    colors = {
        'high mannose':        'green',
        'sialofucosylated':    'blue',
        'sialylated':          'magenta',
        'fucosylated':         'red'
    }

    fig, ax = plt.subplots(figsize=(6, 4))
    ax.bar(
        class_order,
        means.values,
        color=[colors[c] for c in class_order]
    )
    ax.set_xlabel('Glycan Class', fontsize=12)
    ax.set_ylabel('Average Relative Abundance', fontsize=12)
    ax.set_title('Mean Relative Abundance by Glycan Class', fontsize=14)
    ax.set_ylim(0, means.max() * 1.1)
    plt.xticks(rotation=45, ha='right')
    plt.tight_layout()

    if save_path:
        plt.savefig(save_path, dpi=300)
        print(f"Saved class‐abundance plot to {save_path}")
    else:
        plt.show()

    return means
